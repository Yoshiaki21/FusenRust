# テスト用: CachyOS 上の podman（Quadlet）で fusen-server を動かす
#
# 使い方:
#   1. イメージを作る（リポジトリのルートで）
#        podman build -f deploy/Containerfile -t localhost/fusen-server:latest .
#   2. このファイルを置いて systemd に読み込ませる（ユーザー単位）
#        mkdir -p ~/.config/containers/systemd
#        cp deploy/fusen-server.container ~/.config/containers/systemd/
#        systemctl --user daemon-reload
#        systemctl --user start fusen-server
#   3. トークンを発行する
#        podman exec fusen-server fusen-server token create --device cachyos-main
#   4. 動作確認
#        curl http://127.0.0.1:9090/healthz
#
# 管理画面（トークンの発行・無効化など。使うときだけ。D-016）:
#   ~/.config/containers/systemd/fusen-server.container の下の FUSEN_ADMIN_* の 2 行の # を外し、
#   パスワード（8 文字以上）を書いて、systemctl --user daemon-reload && systemctl --user restart fusen-server
#   → http://127.0.0.1:9010 。使い終わったら # を戻して、もう一度 daemon-reload と restart

[Unit]
Description=FusenRust 同期サーバー（テスト）

[Container]
Image=localhost/fusen-server:latest
ContainerName=fusen-server
# データは名前付きボリュームに置く（podman volume inspect fusen-data で場所を確認できる）
Volume=fusen-data:/data:Z
# テストなのでこの PC からだけ接続できるようにする（他の PC から試すなら 127.0.0.1: を外す）。
# 開発 PC では 8080 を別のサーバーが使っているので 9090 にしている（コンテナ内は 8080 のまま）
PublishPort=127.0.0.1:9090:8080
Environment=FUSEN_MAX_UPLOAD_BYTES=524288000
Environment=RUST_LOG=info
# 管理画面（コンテナの中は 0.0.0.0:9010、ホストは 127.0.0.1:9010 だけ）
PublishPort=127.0.0.1:9010:9010
#Environment=FUSEN_ADMIN_LISTEN=0.0.0.0:9010
#Environment=FUSEN_ADMIN_PASSWORD=

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
