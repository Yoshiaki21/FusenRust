# fusen-server（docker compose）の設定。deploy/.env にコピーして使う。

# 待ち受けるアドレス（ホスト側）
#   127.0.0.1 … Caddy を同じ LXC で動かすとき（既定。外から直接つながらない）
#   0.0.0.0   … Caddy が別の LXC・ホストにあるとき（ファイアウォールで接続元を絞ること）
FUSEN_BIND=127.0.0.1

# 待ち受けるポート（ホスト側）
FUSEN_PORT=8080

# データの置き場所（fusen.db と blobs/）。uid 10001 が書き込めるようにしておく
FUSEN_DATA_PATH=./data

# 1 ファイルの添付の上限（バイト）。Caddyfile の request_body max_size と合わせる
FUSEN_MAX_UPLOAD_BYTES=524288000

# ログの詳しさ（error / warn / info / debug）
RUST_LOG=info

# ■ 管理画面（トークンの発行・無効化・最終使用日時の確認など。docs/decisions.md D-016）
# 使うときだけ下の 2 行の # を外して `docker compose -f deploy/compose.yaml up -d` で作り直す。
# 使い終わったら # を戻して、もう一度作り直す（無効の間は何も待ち受けない）。
# - コンテナの中では 0.0.0.0:9010 で待ち受けるが、ホスト側は常に 127.0.0.1 にだけ公開する（Caddy では中継しない）
# - 別の PC から使うときは SSH のポート転送: ssh -L 9010:127.0.0.1:9010 <この LXC>  → http://127.0.0.1:9010
# - パスワードは 8 文字以上（未設定だとサーバーが起動しない）
#FUSEN_ADMIN_LISTEN=0.0.0.0:9010
#FUSEN_ADMIN_PASSWORD=

# 管理画面のホスト側のポート
FUSEN_ADMIN_PORT=9010
